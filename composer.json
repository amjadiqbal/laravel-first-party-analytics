{
    "name": "amjadiqbal/laravel-first-party-analytics",
    "description": "Self-hosted, privacy-friendly web analytics for Laravel, stored in your own database: visits and sessions, pages, referrers and UTM campaigns, custom events from PHP and JavaScript, conversions and funnels, bot filtering, a no-cookie mode, IP anonymisation, Do-Not-Track/GPC, retention pruning and a gated Blade dashboard. A Google Analytics alternative with no third-party calls.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "amjadiqbal",
        "laravel",
        "laravel-package",
        "analytics",
        "web-analytics",
        "self-hosted-analytics",
        "privacy",
        "gdpr",
        "visitor-tracking",
        "pageviews",
        "utm",
        "referrer",
        "conversion-tracking",
        "funnel",
        "google-analytics-alternative"
    ],
    "homepage": "https://amjad.com.pk/laravel/packages/laravel-first-party-analytics",
    "authors": [
        {
            "name": "Amjad Iqbal",
            "homepage": "https://amjad.com.pk",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/amjadiqbal/laravel-first-party-analytics/issues",
        "source": "https://github.com/amjadiqbal/laravel-first-party-analytics",
        "docs": "https://amjad.com.pk/laravel/packages/laravel-first-party-analytics"
    },
    "require": {
        "php": "^8.3",
        "illuminate/auth": "^12.0|^13.0",
        "illuminate/bus": "^12.0|^13.0",
        "illuminate/cache": "^12.0|^13.0",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/cookie": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/queue": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/view": "^12.0|^13.0",
        "jaybizzle/crawler-detect": "^1.3"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "AmjadIqbal\\FirstPartyAnalytics\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AmjadIqbal\\FirstPartyAnalytics\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AmjadIqbal\\FirstPartyAnalytics\\FirstPartyAnalyticsServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "pint": "vendor/bin/pint --test",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G"
    }
}
